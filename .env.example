# Supabase の Project Settings → API からコピーして .env.local（Vercel では Environment Variables）に設定します
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# サーバー専用（NEXT_PUBLIC を付けない・公開しない）
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 公開URL（例 https://gallery-crypto-site.vercel.app）
NEXT_PUBLIC_SITE_URL=

# 管理者への通知メール（Resend の API キー。未設定なら通知しない）
RESEND_API_KEY=
# 通知先（省略時は admins テーブルのメール）
NOTIFY_EMAIL=
